# 엘리스 ML API. 키는 ML API > API Key 관리 > Serverless 탭에서 발급한다.
ELICE_SERVERLESS_API_KEY=
# 모델별 Serverless 엔드포인트(OpenAI 호환). 형식: https://mlapi.run/<endpoint-id>/v1
LLM_BASE_URL=
# 데이터셋 선정과 dev set 구축은 gpt-6.1-terra, Query 경로는 LLM 선정 결과(research/llm_selection.md)인 claude-haiku-5-5를 쓴다.
LLM_MODEL=gpt-6.1-terra
# Query 경로의 생성 모델 엔드포인트(claude-haiku-5-5). 형식: https://mlapi.run/<endpoint-id>/v1
ANSWER_LLM_BASE_URL=
# 설정하면 /v1/* 요청에 X-API-Key 헤더가 필요하다. 비워 두면 검사하지 않는다(로컬 개발용).
API_KEY=
# LLM 선정 실험 후보 엔드포인트. 모델명을 키로 하는 JSON. 예: {"gpt-6.1-terra":"https://mlapi.run/<endpoint-id>/v1"}
# LLM_CANDIDATE_URLS=

# 평가 기록 저장소(evaldb) 비밀번호. 필수. 예: openssl rand -hex 24 의 출력
EVAL_DB_PASSWORD=

# 선택. GitHub API 호출 한도(시간당 60회)를 넘을 때만 필요하다.
GITHUB_TOKEN=

# console 또는 json
LOG_FORMAT=console
LOG_LEVEL=INFO
